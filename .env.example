# Copy to .env (make.ps1 up does this if .env is missing). Never commit .env.
# Values are read inside the Docker containers. Service hostnames (postgres, redis, neo4j)
# are rewritten by docker-compose for web and worker; the keys below are the ones you edit.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=docintel
POSTGRES_USER=docintel
POSTGRES_PASSWORD=docintel

NEO4J_USER=neo4j
NEO4J_PASSWORD=docintel-neo4j

# anthropic | openai | google | mock. mock needs no API key and is what the tests use.
# A real provider with a missing key or an unknown model stops web, worker and every command at startup.
# Check with: docker compose exec web python manage.py check_llm
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini (LLM_PROVIDER=google, e.g. LLM_MODEL=gemini-2.5-flash). Key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Free tiers: at most this many LLM calls in flight across web, worker and commands. 429s back off exponentially.
LLM_MAX_CONCURRENCY=2
LLM_RATE_LIMIT_RETRIES=6
LLM_BACKOFF_BASE_SECONDS=4
LLM_BACKOFF_MAX_SECONDS=90

# local | openai | mock.
# openai uses text-embedding-3-small at 384 dimensions (OPENAI_API_KEY required).
# local needs INSTALL_ML=1 (below) and a rebuild: docker compose build. Any 384-dim model works,
# e.g. EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5 (default sentence-transformers/all-MiniLM-L6-v2).
# After changing provider or model, rebuild vectors: docker compose exec web python manage.py reembed
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_MODEL=
INSTALL_ML=0

# Cross-encoder rerank. Leave false unless the image was built with INSTALL_ML=1.
# hybrid+rerank then uses an offline lexical rerank instead.
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_MIN_VECTOR_SIMILARITY=0.25

# Knowledge graph store: neo4j (the compose service) or networkx (a JSON file under MEDIA_ROOT/kg/).
GRAPH_BACKEND=neo4j
# v1 is the naive extraction prompt, v2 the engineered one.
KG_PROMPT_VERSION=v2
# Extract entities and rebuild the graph after each ingest run.
KG_AUTO_BUILD=true
KG_ENTITY_MIN_SIMILARITY=0.55

# Rules extraction prompt (v1 naive, v2 engineered) and merge / conflict thresholds.
RULES_PROMPT_VERSION=v2
RULES_MERGE_SIMILARITY=0.9
RULES_CONFLICT_SIMILARITY=0.6

# Compliance agent: retrieval mode for hybrid_search, chunks per search, and how many times a
# failed citation check may send the graph back to retrieval before it goes to approval with a warning.
AGENT_RETRIEVAL_MODE=hybrid_rerank
AGENT_TOP_K=6
AGENT_MAX_LOOPS=2

# Extra attempts after the first try of a failing ingest stage.
INGEST_MAX_RETRIES=2
INGEST_CHUNK_MAX_TOKENS=300
INGEST_CHUNK_MIN_TOKENS=40
# Set to a stage name (detect, parse, clean, chunk, enrich, embed, index)
# to fail that stage once, so the retry path is visible in the UI. Restart the worker after changing.
INGEST_CHAOS_STAGE=
